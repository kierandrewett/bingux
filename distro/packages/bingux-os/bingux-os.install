# The Bingux login screen replaces greetd's stock configuration. bingux
# ships the configuration as /usr/share/bingux/greeter/greetd.toml so there is
# one copy; a configuration the administrator has already changed is kept.
install_greeter_config() {
    local config=/etc/greetd/config.toml
    if [ ! -e "$config" ] || ! grep -q '^command *=' "$config" || grep -q 'agreety' "$config"; then
        install -Dm644 /usr/share/bingux/greeter/greetd.toml "$config"
    fi
}

# The [bingux-os] repository, so pacman -Syu keeps the desktop up to date. The
# live image and archinstall copy this section into the installed system.
install_repository() {
    if ! grep -q '^\[bingux-os\]' /etc/pacman.conf; then
        printf '\n[bingux-os]\nSigLevel = Optional TrustAll\nInclude = /etc/pacman.d/bingux-os-mirrorlist\n' >>/etc/pacman.conf
    fi
}

# archinstall creates the account before it installs the additional packages,
# so the account misses the files this package puts in /etc/skel. Give regular
# accounts the Gnoblin configuration when they have none; without it Gnoblin
# seeds its own example, which does not load the Bingux drop-ins, and the
# session shows no shell.
seed_existing_accounts() {
    local skel=/etc/skel/.config/gnoblin/init.lua name uid gid home existing
    while IFS=: read -r name _ uid gid _ home _; do
        { [ "$uid" -ge 1000 ] && [ "$uid" -lt 60000 ] && [ -d "$home" ]; } 2>/dev/null || continue
        existing=
        for file in init.lua gnoblin.toml gnoblin.conf; do
            [ -e "$home/.config/gnoblin/$file" ] && existing=1
        done
        [ -z "$existing" ] || continue
        install -d -o "$uid" -g "$gid" -m 755 "$home/.config" "$home/.config/gnoblin"
        install -o "$uid" -g "$gid" -m 644 "$skel" "$home/.config/gnoblin/init.lua"
    done </etc/passwd
}

# The boot splash runs from the initramfs, so the plymouth hook has to be in
# mkinitcpio's HOOKS. It goes after kms so the splash gets the graphics driver
# before the root filesystem is mounted. A configuration that already has it is left alone.
install_boot_splash() {
    local config=/etc/mkinitcpio.conf
    [ -f "$config" ] || return 0
    grep -Eq '^HOOKS=.*\bplymouth\b' "$config" && return 0
    grep -Eq '^HOOKS=.*\bkms\b' "$config" || return 0
    sed -i -E '/^HOOKS=/ s/\bkms\b/kms plymouth/' "$config"
    mkinitcpio -P >/dev/null 2>&1 || true
}

post_install() {
    install_repository
    install_greeter_config
    seed_existing_accounts
    systemctl enable greetd.service NetworkManager.service >/dev/null 2>&1 || true
    systemctl set-default graphical.target >/dev/null 2>&1 || true
    # Bingux's helper daemons (status, search, lock requests) follow every
    # Gnoblin session; the unit has no preset on Arch.
    systemctl --global enable bingux.target >/dev/null 2>&1 || true
    install_boot_splash
}

post_upgrade() {
    install_greeter_config
    install_boot_splash
}
