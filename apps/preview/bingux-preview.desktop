[Desktop Entry]
Type=Application
Name=Preview
Comment=View pictures and documents
Exec=bingux-preview %U
Icon=bingux-preview
Terminal=false
Categories=Graphics;Viewer;
Keywords=Picture;Image;Photo;PDF;Document;Slideshow;Viewer;
MimeType=image/png;image/jpeg;image/gif;image/webp;image/bmp;image/tiff;image/avif;image/heif;image/heic;image/svg+xml;image/vnd.microsoft.icon;image/x-icon;application/pdf;x-scheme-handler/bingux-preview;
StartupWMClass=bingux-preview
StartupNotify=true
