[Unit]
Description=Bingux global shortcuts provider
PartOf=bingux.target
# The login screen's account never runs desktop applications.
ConditionUser=!greeter
ConditionUser=!greetd
After=graphical-session.target

[Service]
Type=dbus
BusName=org.gnoblin.Shell.GlobalShortcutsProvider
ExecStart=/usr/libexec/bingux/bingux-global-shortcuts
Environment=BINGUXCTL=/usr/bin/binguxctl
Restart=on-failure
RestartSec=3
LimitCORE=0
