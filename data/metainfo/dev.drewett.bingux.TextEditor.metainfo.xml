<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>dev.drewett.bingux.TextEditor</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>Text Editor</name>
  <summary>Edit text files and code</summary>
  <developer id="dev.drewett">
    <name>Kieran Drewett</name>
  </developer>
  <description>
    <p>
      Text Editor is the Bingux desktop's editor for plain text and code. A new
      window is a blank document ready to type in, and nothing typed is lost:
      unsaved documents come back after a restart.
    </p>
    <ul>
      <li>Tabs, open recent files, and each file opens where it was left</li>
      <li>Colours for about 200 languages, line numbers, wrapping and several carets</li>
      <li>Find and replace with regular expressions, whole words and matching case</li>
      <li>Any encoding and line ending, kept as the file had them</li>
      <li>A Markdown preview beside the text</li>
      <li>Large files and logs open and scroll quickly</li>
    </ul>
  </description>
  <launchable type="desktop-id">bingux-text-editor.desktop</launchable>
  <url type="homepage">https://github.com/kierandrewett/bingux</url>
  <url type="bugtracker">https://github.com/kierandrewett/bingux/issues</url>
  <url type="vcs-browser">https://github.com/kierandrewett/bingux</url>
  <url type="help">https://github.com/kierandrewett/bingux/tree/main/docs</url>
  <provides>
    <binary>bingux-text-editor</binary>
    <mediatype>text/plain</mediatype>
    <mediatype>text/markdown</mediatype>
  </provides>
  <supports>
    <control>pointing</control>
    <control>keyboard</control>
    <control>touch</control>
  </supports>
  <requires>
    <display_length compare="ge">360</display_length>
  </requires>
  <content_rating type="oars-1.1"/>
  <categories>
    <category>Utility</category>
    <category>TextEditor</category>
  </categories>
  <releases>
    <release version="0.1.0" date="2026-11-09"/>
  </releases>
</component>
