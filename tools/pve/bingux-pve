#!/usr/bin/env bash

# Authentication is used only in memory and mode-600 temporary files for curl;
# it is never written to stdout, stderr, or the evidence directory.

set -euo pipefail
set +x
umask 077

readonly POLL_INTERVAL_SECONDS=2
readonly POLL_TIMEOUT_SECONDS=1800
readonly VMID_MIN=100
readonly VMID_MAX=999999999
readonly DEFAULT_VM_CORES=8
readonly VM_CORES_MIN=1
readonly VM_CORES_MAX=128
readonly DEFAULT_VM_MEMORY_MIB=8192
readonly VM_MEMORY_MIB_MIN=512
readonly VM_MEMORY_MIB_MAX=1048576
readonly BINGUX_VM_TAG='bingux-pve-test'
readonly CONNECT_TIMEOUT_SECONDS=10
readonly CONTROL_REQUEST_TIMEOUT_SECONDS=30
readonly UPLOAD_REQUEST_TIMEOUT_SECONDS=3600
readonly MAX_API_RESPONSE_BYTES=1048576
readonly LOW_SPEED_LIMIT_BYTES_PER_SECOND=1024
readonly LOW_SPEED_TIME_SECONDS=30

VM_CREATION_ATTEMPTED=0
CREATE_TASK_TERMINAL=0
START_TASK_TERMINAL=0
START_REQUEST_ATTEMPTED=0
CLEANUP_ATTEMPTED=0
LAST_EVIDENCE_WRITTEN=0
LAST_TASK_TERMINAL=0
PVE_TOKEN_SECRET_FILE=

usage() {
    cat >&2 <<'EOF'
Usage:
  bingux-pve create --iso FILE --evidence-dir DIR [--destroy-on-failure] [--dry-run]
  bingux-pve destroy --vmid ID --evidence-dir DIR [--dry-run]

Required environment for both operations:
  PVE_API_URL       HTTPS API root, for example https://pve.example:8006/api2/json
  PVE_API_TOKEN_ID  Token identity in USER@REALM!TOKEN form
  PVE_API_TOKEN_FILE
  PVE_NODE

Additional environment for create:
  PVE_ISO_STORAGE  Storage that accepts ISO content uploads
  PVE_VM_STORAGE   Storage for the disposable VM disk
  PVE_BRIDGE       VirtIO bridge for net0
  PVE_VM_CORES     Optional vCPU count (default 8)
  PVE_VM_MEMORY_MIB
                   Optional memory in MiB (default 8192)

Optional environment:
  PVE_CA_BUNDLE    Absolute path to a CA bundle passed to curl --cacert
EOF
}

error() {
    printf 'error: %s\n' "$*" >&2
}

fail_usage() {
    error "$1"
    usage
    exit 2
}

require_nonempty() {
    local name=$1
    if [[ ! -v $name ]]; then
        error "required environment variable is missing: $name"
        exit 2
    fi
    if [[ -z ${!name} ]]; then
        error "required environment variable is empty: $name"
        exit 2
    fi
}

validate_single_line_value() {
    local name=$1
    local value=$2
    if [[ -z $value || $value == *$'\n'* || $value == *$'\r'* ]]; then
        error "invalid value for $name"
        exit 2
    fi
}
validate_bounded_integer() {
    local name=$1
    local value=$2
    local minimum=$3
    local maximum=$4
    local number

    if [[ ! $value =~ ^[0-9]{1,9}$ ]]; then
        error "$name must be a decimal integer"
        exit 2
    fi
    number=$((10#$value))
    if (( number < minimum || number > maximum )); then
        error "$name must be between $minimum and $maximum"
        exit 2
    fi
}
validate_iso_path_for_curl() {
    local iso=$1
    local form_unsafe_re='[;"\\]'
    if [[ $iso =~ $form_unsafe_re ]]; then
        error 'ISO path contains unsupported multipart form characters'
        exit 2
    fi
}
validate_environment() {
    local operation=$1
    local api_url_re='^https://([A-Za-z0-9.-]+|\[[0-9A-Fa-f:.]+\])(:[0-9]{1,5})?/api2/json/?$'
    local token_id_re='^[A-Za-z0-9._-]+@[A-Za-z0-9._-]+![A-Za-z0-9._-]+$'
    local segment_re='^[A-Za-z0-9][A-Za-z0-9._-]*$'

    require_nonempty PVE_API_URL
    require_nonempty PVE_API_TOKEN_ID
    require_nonempty PVE_API_TOKEN_FILE
    require_nonempty PVE_NODE
    if [[ $operation == create ]]; then
        require_nonempty PVE_ISO_STORAGE
        require_nonempty PVE_VM_STORAGE
        require_nonempty PVE_BRIDGE
        if [[ ! -v PVE_VM_CORES ]]; then
            PVE_VM_CORES=$DEFAULT_VM_CORES
        fi
        if [[ ! -v PVE_VM_MEMORY_MIB ]]; then
            PVE_VM_MEMORY_MIB=$DEFAULT_VM_MEMORY_MIB
        fi
    fi

    validate_single_line_value PVE_API_URL "$PVE_API_URL"
    validate_single_line_value PVE_API_TOKEN_ID "$PVE_API_TOKEN_ID"
    validate_single_line_value PVE_API_TOKEN_FILE "$PVE_API_TOKEN_FILE"
    validate_single_line_value PVE_NODE "$PVE_NODE"
    if [[ $operation == create ]]; then
        validate_single_line_value PVE_ISO_STORAGE "$PVE_ISO_STORAGE"
        validate_single_line_value PVE_VM_STORAGE "$PVE_VM_STORAGE"
        validate_single_line_value PVE_BRIDGE "$PVE_BRIDGE"
        validate_single_line_value PVE_VM_CORES "$PVE_VM_CORES"
        validate_single_line_value PVE_VM_MEMORY_MIB "$PVE_VM_MEMORY_MIB"
    fi

    if [[ ! $PVE_API_URL =~ $api_url_re ]]; then
        error 'PVE_API_URL must be an https URL ending in /api2/json'
        exit 2
    fi
    if [[ ! $PVE_API_TOKEN_ID =~ $token_id_re ]]; then
        error 'PVE_API_TOKEN_ID has invalid USER@REALM!TOKEN syntax'
        exit 2
    fi
    if [[ ! $PVE_NODE =~ $segment_re ]]; then
        error 'PVE_NODE contains unsupported characters'
        exit 2
    fi
    if [[ $operation == create ]]; then
        if [[ ! $PVE_ISO_STORAGE =~ $segment_re ]]; then
            error 'PVE_ISO_STORAGE contains unsupported characters'
            exit 2
        fi
        if [[ ! $PVE_VM_STORAGE =~ $segment_re ]]; then
            error 'PVE_VM_STORAGE contains unsupported characters'
            exit 2
        fi
        if [[ ! $PVE_BRIDGE =~ $segment_re ]]; then
            error 'PVE_BRIDGE contains unsupported characters'
            exit 2
        fi
        validate_bounded_integer PVE_VM_CORES "$PVE_VM_CORES" "$VM_CORES_MIN" "$VM_CORES_MAX"
        validate_bounded_integer PVE_VM_MEMORY_MIB "$PVE_VM_MEMORY_MIB" "$VM_MEMORY_MIB_MIN" "$VM_MEMORY_MIB_MAX"
    fi

    if [[ -n ${PVE_CA_BUNDLE:-} ]]; then
        validate_single_line_value PVE_CA_BUNDLE "$PVE_CA_BUNDLE"
        if [[ $PVE_CA_BUNDLE != /* ]]; then
            error 'PVE_CA_BUNDLE must be an absolute path'
            exit 2
        fi
    fi
    BASE_URL=${PVE_API_URL%/}
}

validate_vmid() {
    local vmid=$1
    local number
    if [[ ! $vmid =~ ^[1-9][0-9]{0,8}$ ]]; then
        return 1
    fi
    number=$((10#$vmid))
    (( number >= VMID_MIN && number <= VMID_MAX ))
}

validate_iso_argument() {
    local iso=$1
    local iso_name
    validate_single_line_value '--iso' "$iso"
    validate_iso_path_for_curl "$iso"
    iso_name=${iso##*/}
    if [[ ! $iso_name =~ ^[A-Za-z0-9][A-Za-z0-9._-]*\.iso$ ]]; then
        error 'ISO basename must be a simple .iso filename'
        exit 2
    fi
    if [[ ! -f $iso || ! -r $iso || ! -s $iso ]]; then
        error 'ISO must be a readable, non-empty regular file'
        exit 2
    fi
    ISO_NAME=$iso_name
}

validate_dry_run_iso_argument() {
    local iso=$1
    local iso_name
    validate_single_line_value '--iso' "$iso"
    validate_iso_path_for_curl "$iso"
    iso_name=${iso##*/}
    if [[ ! $iso_name =~ ^[A-Za-z0-9][A-Za-z0-9._-]*\.iso$ ]]; then
        error 'ISO basename must be a simple .iso filename'
        exit 2
    fi
    ISO_NAME=$iso_name
}

prepare_runtime() {
    local token_secret
    local token_mode
    local -a token_lines=()
    local token_re='^[A-Za-z0-9._~+=/@!%-]+$'

    if [[ ! -f $PVE_API_TOKEN_FILE || ! -r $PVE_API_TOKEN_FILE ]]; then
        error 'PVE_API_TOKEN_FILE must be a readable regular file'
        exit 2
    fi
    if ! token_mode=$(stat --format '%a' -- "$PVE_API_TOKEN_FILE"); then
        error 'unable to read PVE_API_TOKEN_FILE permissions'
        exit 1
    fi
    if (( (8#$token_mode & 8#077) != 0 )); then
        error 'PVE_API_TOKEN_FILE must not be accessible to group or other users'
        exit 2
    fi
    if [[ -n ${PVE_CA_BUNDLE:-} ]]; then
        if [[ ! -f $PVE_CA_BUNDLE || ! -r $PVE_CA_BUNDLE ]]; then
            error 'PVE_CA_BUNDLE must be a readable regular file'
            exit 2
        fi
    fi
    if ! TMP_DIR=$(mktemp -d); then
        error 'unable to create a secure temporary directory'
        exit 1
    fi
    trap cleanup EXIT

    if ! mkdir -p -- "$EVIDENCE_DIR"; then
        error 'unable to create evidence directory'
        exit 1
    fi
    if [[ ! -d $EVIDENCE_DIR || ! -w $EVIDENCE_DIR ]]; then
        error 'evidence directory must be writable'
        exit 1
    fi
    if ! RUN_DIR=$(mktemp -d -- "$EVIDENCE_DIR/run.XXXXXX"); then
        error 'unable to create evidence run directory'
        exit 1
    fi

    mapfile -t token_lines <"$PVE_API_TOKEN_FILE"
    if (( ${#token_lines[@]} != 1 )); then
        error 'PVE_API_TOKEN_FILE must contain exactly one non-empty token line'
        exit 2
    fi
    token_secret=${token_lines[0]}
    if [[ -z $token_secret || ! $token_secret =~ $token_re ]]; then
        error 'PVE_API_TOKEN_FILE must contain exactly one non-empty token line'
        exit 2
    fi
    PVE_TOKEN_SECRET=$token_secret
    PVE_TOKEN_SECRET_FILE="$TMP_DIR/token-secret"
    if ! printf '%s' "$PVE_TOKEN_SECRET" >"$PVE_TOKEN_SECRET_FILE"; then
        error 'unable to prepare secure token secret'
        exit 1
    fi
    PVE_TOKEN_ID_FILE="$TMP_DIR/token-id"
    PVE_CURL_CONFIG="$TMP_DIR/curl.conf"
    if ! printf '%s' "$PVE_API_TOKEN_ID" >"$PVE_TOKEN_ID_FILE"; then
        error 'unable to prepare secure token metadata'
        exit 1
    fi
    if ! printf 'header = "Authorization: PVEAPIToken=%s=%s"\n' "$PVE_API_TOKEN_ID" "$PVE_TOKEN_SECRET" >"$PVE_CURL_CONFIG"; then
        error 'unable to prepare secure API authentication'
        exit 1
    fi

    if [[ -n ${PVE_CA_BUNDLE:-} ]]; then
        CURL_CA_ARGS=(--cacert "$PVE_CA_BUNDLE")
    else
        CURL_CA_ARGS=()
    fi

}

cleanup() {
    local status=$?
    if [[ -n ${TMP_DIR:-} && -d ${TMP_DIR:-} ]]; then
        rm -rf -- "$TMP_DIR" || true
    fi
    unset PVE_TOKEN_SECRET PVE_TOKEN_SECRET_FILE PVE_TOKEN_ID_FILE PVE_CURL_CONFIG
    exit "$status"
}

log_request() {
    local operation=$1
    local endpoint=$2
    printf 'request operation=%s endpoint=%s\n' "$operation" "$endpoint" >&2
}

log_task_result() {
    local operation=$1
    local upid=$2
    local status=$3
    printf 'task operation=%s upid=%s terminal_status=%s\n' "$operation" "$upid" "$status" >&2
}

api_request() {
    local operation=$1
    local method=$2
    local endpoint=$3
    local response_file=$4
    shift 4

    local http_code
    local curl_status=0
    local -a curl_args
    curl_args=(
        --disable
        --silent
        --show-error
        --fail-with-body
        --proto '=https'
        --connect-timeout "$CONNECT_TIMEOUT_SECONDS"
        --max-filesize "$MAX_API_RESPONSE_BYTES"
        --speed-limit "$LOW_SPEED_LIMIT_BYTES_PER_SECOND"
        --speed-time "$LOW_SPEED_TIME_SECONDS"
        --config "$PVE_CURL_CONFIG"
        --request "$method"
        --header 'Accept: application/json'
    )
    if [[ -n ${API_REQUEST_MAX_TIME_SECONDS:-} ]]; then
        curl_args+=(--max-time "$API_REQUEST_MAX_TIME_SECONDS")
    fi
    if ((${#CURL_CA_ARGS[@]} > 0)); then
        curl_args+=("${CURL_CA_ARGS[@]}")
    fi
    curl_args+=("$@" --output "$response_file" --write-out '%{http_code}' "$endpoint")

    log_request "$operation" "$endpoint"
    http_code=$(curl "${curl_args[@]}" 2>"$TMP_DIR/curl-error") || curl_status=$?
    LAST_HTTP_CODE=${http_code:-000}

    if (( curl_status != 0 )); then
        return 1
    fi
    if [[ ! $LAST_HTTP_CODE =~ ^2[0-9][0-9]$ ]]; then
        return 1
    fi
    if ! jq -e 'type == "object"' "$response_file" >/dev/null 2>&1; then
        return 1
    fi
    return 0
}

api_request_with_timeout() {
    local max_time_seconds=$1
    shift
    local API_REQUEST_MAX_TIME_SECONDS=$max_time_seconds
    api_request "$@"
}

next_evidence_path() {
    local label=$1
    EVIDENCE_SEQUENCE=$((EVIDENCE_SEQUENCE + 1))
    printf -v REPLY '%s/%03d-%s.json' "$RUN_DIR" "$EVIDENCE_SEQUENCE" "$label"
}

write_request_evidence() {
    local operation=$1
    local endpoint=$2
    local terminal_status=$3
    local label=$4
    local evidence_path
    local temp_path

    next_evidence_path "$label"
    evidence_path=$REPLY
    temp_path="$TMP_DIR/evidence.tmp"
    if ! jq -n \
        --arg operation "$operation" \
        --arg endpoint "$endpoint" \
        --arg terminal_status "$terminal_status" \
        '{request_operation: $operation, endpoint: $endpoint, task_upid: null, terminal_status: $terminal_status, task_log: []}' \
        >"$temp_path" 2>/dev/null; then
        return 1
    fi
    if ! mv -f -- "$temp_path" "$evidence_path"; then
        return 1
    fi
    return 0
}

redact_task_log() {
    local source_file=$1
    local destination_file=$2
    jq --rawfile secret_file "$PVE_TOKEN_SECRET_FILE" --rawfile token_id_file "$PVE_TOKEN_ID_FILE" '
        $secret_file as $secret |
        $token_id_file as $token_id |
        map(
            if type == "object" and (.t | type == "string") then
                .t |= (
                    if ($secret | length) > 0 then split($secret) | join("[REDACTED]") else . end
                    | if ($token_id | length) > 0 then split($token_id) | join("[REDACTED]") else . end
                )
            else
                .
            end
        )
    ' "$source_file" >"$destination_file" 2>/dev/null
}

write_task_evidence() {
    local operation=$1
    local endpoint=$2
    local upid=$3
    local terminal_status=$4
    local task_log_file=$5
    local evidence_path=$6
    local task_log_error=${7:-}
    local redacted_log="$TMP_DIR/redacted-log.json"
    local temp_path="$TMP_DIR/task-evidence.tmp"

    if ! redact_task_log "$task_log_file" "$redacted_log"; then
        return 1
    fi
    if [[ -n $task_log_error ]]; then
        if ! jq -n \
            --arg operation "$operation" \
            --arg endpoint "$endpoint" \
            --arg upid "$upid" \
            --arg terminal_status "$terminal_status" \
            --arg task_log_error "$task_log_error" \
            --slurpfile task_log "$redacted_log" \
            '{request_operation: $operation, endpoint: $endpoint, task_upid: $upid, terminal_status: $terminal_status, task_log: $task_log[0], task_log_error: $task_log_error}' \
            >"$temp_path" 2>/dev/null; then
            return 1
        fi
    else
        if ! jq -n \
            --arg operation "$operation" \
            --arg endpoint "$endpoint" \
            --arg upid "$upid" \
            --arg terminal_status "$terminal_status" \
            --slurpfile task_log "$redacted_log" \
            '{request_operation: $operation, endpoint: $endpoint, task_upid: $upid, terminal_status: $terminal_status, task_log: $task_log[0]}' \
            >"$temp_path" 2>/dev/null; then
            return 1
        fi
    fi
    if ! mv -f -- "$temp_path" "$evidence_path"; then
        return 1
    fi
    return 0
}
write_task_fallback_evidence() {
    local operation=$1
    local endpoint=$2
    local upid=$3
    local terminal_status=$4
    local evidence_path=$5
    local temp_path="$TMP_DIR/task-evidence-fallback.tmp"

    if ! jq -n \
        --arg operation "$operation" \
        --arg endpoint "$endpoint" \
        --arg upid "$upid" \
        --arg terminal_status "$terminal_status" \
        '{request_operation: $operation, endpoint: $endpoint, task_upid: $upid, terminal_status: $terminal_status, task_log: [], task_log_error: "unavailable"}' \
        >"$temp_path" 2>/dev/null; then
        return 1
    fi
    if ! mv -f -- "$temp_path" "$evidence_path"; then
        return 1
    fi
    return 0
}

validate_upid() {
    local upid=$1
    local upid_re='^UPID:[A-Za-z0-9._-]+:[0-9A-Fa-f]+:[0-9A-Fa-f]+:[0-9A-Fa-f]+:[A-Za-z0-9._-]+:[A-Za-z0-9._-]*:[A-Za-z0-9._+@!-]+:$'
    [[ $upid =~ $upid_re ]]
}

wait_for_task() {
    local operation=$1
    local request_endpoint=$2
    local upid=$3
    local evidence_path=$4
    local status_endpoint="$BASE_URL/nodes/$PVE_NODE/tasks/$upid/status"
    local log_endpoint="$BASE_URL/nodes/$PVE_NODE/tasks/$upid/log"
    local status_response="$TMP_DIR/task-status.json"
    local log_response="$TMP_DIR/task-log.json"
    local task_log_file="$TMP_DIR/task-log-items.json"
    local terminal_status='POLL_ERROR'
    local task_state
    local exit_status
    local deadline
    local now
    local task_log_error=''
    local remaining_seconds
    local request_timeout_seconds

    LAST_TASK_TERMINAL=0
    LAST_EVIDENCE_WRITTEN=0
    printf '[]\n' >"$task_log_file"
    deadline=$(( $(date +%s) + POLL_TIMEOUT_SECONDS ))

    while :; do
        if ! now=$(date +%s); then
            terminal_status='POLL_ERROR'
            break
        fi
        if (( now >= deadline )); then
            terminal_status='TIMEOUT'
            break
        fi
        remaining_seconds=$((deadline - now))
        request_timeout_seconds=$(( remaining_seconds < CONTROL_REQUEST_TIMEOUT_SECONDS ? remaining_seconds : CONTROL_REQUEST_TIMEOUT_SECONDS ))
        if ! api_request_with_timeout "$request_timeout_seconds" "$operation.poll.status" GET "$status_endpoint" "$status_response"; then
            terminal_status='POLL_ERROR'
            break
        fi
        if ! jq -e '.data | (type == "object") and (has("status"))' "$status_response" >/dev/null 2>&1; then
            terminal_status='INVALID_STATUS'
            break
        fi
        task_state=$(jq -r '.data.status // empty' "$status_response" 2>/dev/null || true)
        exit_status=$(jq -r 'if (.data.exitstatus | type) == "string" then .data.exitstatus else empty end' "$status_response" 2>/dev/null || true)
        if [[ $task_state == stopped ]]; then
            if [[ -n $exit_status ]]; then
                terminal_status=$exit_status
                LAST_TASK_TERMINAL=1
            else
                terminal_status='UNKNOWN'
            fi
            break
        fi
        if [[ $task_state != running ]]; then
            terminal_status='INVALID_STATUS'
            break
        fi
        if ! now=$(date +%s); then
            terminal_status='POLL_ERROR'
            break
        fi
        if (( now >= deadline )); then
            terminal_status='TIMEOUT'
            break
        fi
        if ! sleep "$POLL_INTERVAL_SECONDS"; then
            terminal_status='POLL_ERROR'
            break
        fi
    done


    if api_request_with_timeout "$CONTROL_REQUEST_TIMEOUT_SECONDS" "$operation.poll.log" GET "$log_endpoint" "$log_response" \
        && jq -e '.data | (type == "array") and (if type == "array" then all(.[]; type == "object" and (.n | type == "number") and (.t | type == "string")) else false end)' "$log_response" >/dev/null 2>&1 \
        && jq '.data | map({n: .n, t: .t})' "$log_response" >"$task_log_file" 2>/dev/null; then
        :
    else
        task_log_error='unavailable'
    fi

    if ! write_task_evidence "$operation" "$request_endpoint" "$upid" "$terminal_status" "$task_log_file" "$evidence_path" "$task_log_error"; then
        if ! write_task_fallback_evidence "$operation" "$request_endpoint" "$upid" "$terminal_status" "$evidence_path"; then
            LAST_EVIDENCE_WRITTEN=0
        else
            LAST_EVIDENCE_WRITTEN=1
        fi
        error "unable to write full evidence for task operation=$operation"
        return 1
    fi
    LAST_EVIDENCE_WRITTEN=1
    log_task_result "$operation" "$upid" "$terminal_status"
    if [[ $terminal_status == OK ]]; then
        if [[ -n $task_log_error ]]; then
            error "task log is unavailable for operation=$operation"
        fi
        return 0
    fi
    return 1
}
print_create_dry_run() {
    local upload_endpoint="$BASE_URL/nodes/$PVE_NODE/storage/$PVE_ISO_STORAGE/upload"
    local create_endpoint="$BASE_URL/nodes/$PVE_NODE/qemu"
    printf 'DRY-RUN POST %s\n' "$upload_endpoint"
    printf 'DRY-RUN FORM content=iso filename=%s\n' "$ISO_NAME"
    printf 'DRY-RUN GET %s\n' "$BASE_URL/nodes/$PVE_NODE/tasks/<upload-upid>/status"
    printf 'DRY-RUN GET %s\n' "$BASE_URL/nodes/$PVE_NODE/tasks/<upload-upid>/log"
    printf 'DRY-RUN GET %s\n' "$BASE_URL/cluster/nextid"
    printf 'DRY-RUN POST %s\n' "$create_endpoint"
    printf 'DRY-RUN DATA vmid=<vmid>\n'
    printf 'DRY-RUN DATA name=bingux-install-<vmid>\n'
    printf 'DRY-RUN DATA tags=%s\n' "$BINGUX_VM_TAG"
    printf 'DRY-RUN DATA scsi0=%s:64,discard=on\n' "$PVE_VM_STORAGE"
    printf 'DRY-RUN DATA ide2=%s:iso/%s,media=cdrom\n' "$PVE_ISO_STORAGE" "$ISO_NAME"
    printf 'DRY-RUN DATA boot=order=ide2;scsi0\n'
    printf 'DRY-RUN DATA cores=%s\n' "$PVE_VM_CORES"
    printf 'DRY-RUN DATA memory=%s\n' "$PVE_VM_MEMORY_MIB"
    printf 'DRY-RUN DATA cpu=host\n'
    printf 'DRY-RUN DATA ostype=l26\n'
    printf 'DRY-RUN DATA net0=virtio,bridge=%s\n' "$PVE_BRIDGE"
    printf 'DRY-RUN GET %s\n' "$BASE_URL/nodes/$PVE_NODE/tasks/<create-upid>/status"
    printf 'DRY-RUN GET %s\n' "$BASE_URL/nodes/$PVE_NODE/tasks/<create-upid>/log"
    printf 'DRY-RUN POST %s\n' "$BASE_URL/nodes/$PVE_NODE/qemu/<vmid>/status/start"
    printf 'DRY-RUN GET %s\n' "$BASE_URL/nodes/$PVE_NODE/tasks/<start-upid>/status"
    printf 'DRY-RUN GET %s\n' "$BASE_URL/nodes/$PVE_NODE/tasks/<start-upid>/log"
    if (( DESTROY_ON_FAILURE == 1 )); then
        printf 'DRY-RUN GET %s\n' "$BASE_URL/nodes/$PVE_NODE/qemu/<vmid>/config"
        printf 'DRY-RUN GET %s\n' "$BASE_URL/nodes/$PVE_NODE/qemu/<vmid>/status/current"
        printf 'DRY-RUN POST %s\n' "$BASE_URL/nodes/$PVE_NODE/qemu/<vmid>/status/shutdown"
        printf 'DRY-RUN GET %s\n' "$BASE_URL/nodes/$PVE_NODE/tasks/<shutdown-upid>/status"
        printf 'DRY-RUN GET %s\n' "$BASE_URL/nodes/$PVE_NODE/tasks/<shutdown-upid>/log"
        printf 'DRY-RUN POST %s\n' "$BASE_URL/nodes/$PVE_NODE/qemu/<vmid>/status/stop"
        printf 'DRY-RUN GET %s\n' "$BASE_URL/nodes/$PVE_NODE/tasks/<stop-upid>/status"
        printf 'DRY-RUN GET %s\n' "$BASE_URL/nodes/$PVE_NODE/tasks/<stop-upid>/log"
        printf 'DRY-RUN DELETE %s\n' "$BASE_URL/nodes/$PVE_NODE/qemu/<vmid>?purge=1&destroy-unreferenced-disks=1"
        printf 'DRY-RUN GET %s\n' "$BASE_URL/nodes/$PVE_NODE/tasks/<destroy-upid>/status"
        printf 'DRY-RUN GET %s\n' "$BASE_URL/nodes/$PVE_NODE/tasks/<destroy-upid>/log"
    fi
}

print_destroy_dry_run() {
    local config_endpoint="$BASE_URL/nodes/$PVE_NODE/qemu/$VMID/config"
    local status_endpoint="$BASE_URL/nodes/$PVE_NODE/qemu/$VMID/status/current"
    local shutdown_endpoint="$BASE_URL/nodes/$PVE_NODE/qemu/$VMID/status/shutdown"
    local stop_endpoint="$BASE_URL/nodes/$PVE_NODE/qemu/$VMID/status/stop"
    local delete_endpoint="$BASE_URL/nodes/$PVE_NODE/qemu/$VMID?purge=1&destroy-unreferenced-disks=1"
    printf 'DRY-RUN GET %s\n' "$config_endpoint"
    printf 'DRY-RUN GET %s\n' "$status_endpoint"
    printf 'DRY-RUN POST %s\n' "$shutdown_endpoint"
    printf 'DRY-RUN GET %s\n' "$BASE_URL/nodes/$PVE_NODE/tasks/<shutdown-upid>/status"
    printf 'DRY-RUN GET %s\n' "$BASE_URL/nodes/$PVE_NODE/tasks/<shutdown-upid>/log"
    printf 'DRY-RUN POST %s\n' "$stop_endpoint"
    printf 'DRY-RUN GET %s\n' "$BASE_URL/nodes/$PVE_NODE/tasks/<stop-upid>/status"
    printf 'DRY-RUN GET %s\n' "$BASE_URL/nodes/$PVE_NODE/tasks/<stop-upid>/log"
    printf 'DRY-RUN DELETE %s\n' "$delete_endpoint"
    printf 'DRY-RUN GET %s\n' "$BASE_URL/nodes/$PVE_NODE/tasks/<destroy-upid>/status"
    printf 'DRY-RUN GET %s\n' "$BASE_URL/nodes/$PVE_NODE/tasks/<destroy-upid>/log"
}

maybe_cleanup_after_failure() {
    if (( VM_CREATION_ATTEMPTED == 1 && DESTROY_ON_FAILURE == 1 && CLEANUP_ATTEMPTED == 0 )); then
        if (( LAST_EVIDENCE_WRITTEN != 1 )); then
            error 'refusing failure cleanup because failure evidence was not written'
            return 1
        fi
        CLEANUP_ATTEMPTED=1
        if (( CREATE_TASK_TERMINAL != 1 )); then
            error 'refusing failure cleanup because creation task state is not terminal'
            return 0
        fi
        if (( START_REQUEST_ATTEMPTED == 1 && START_TASK_TERMINAL != 1 )); then
            error 'refusing failure cleanup because start request outcome is not terminal'
            return 0
        fi
        error "failure cleanup requested for vmid=$VMID"
        if destroy_vm 'failure-cleanup'; then
            return 0
        fi
        error 'failure cleanup did not complete successfully'
        return 1
    fi
    return 0
}
request_and_wait_task() {
    local operation=$1
    local method=$2
    local endpoint=$3
    local response_file=$4
    local upid
    local evidence_path

    LAST_TASK_TERMINAL=0

    LAST_EVIDENCE_WRITTEN=0
    if ! api_request_with_timeout "$CONTROL_REQUEST_TIMEOUT_SECONDS" "$operation" "$method" "$endpoint" "$response_file"; then
        if ! write_request_evidence "$operation" "$endpoint" "REQUEST_FAILED" "$operation-failed"; then
            LAST_EVIDENCE_WRITTEN=0
        else
            LAST_EVIDENCE_WRITTEN=1
        fi
        return 1
    fi
    if ! upid=$(jq -er '.data | strings' "$response_file" 2>/dev/null) || ! validate_upid "$upid"; then
        if ! write_request_evidence "$operation" "$endpoint" "INVALID_TASK" "$operation-invalid-task"; then
            LAST_EVIDENCE_WRITTEN=0
        else
            LAST_EVIDENCE_WRITTEN=1
        fi
        return 1
    fi
    next_evidence_path "$operation"
    evidence_path=$REPLY
    wait_for_task "$operation" "$endpoint" "$upid" "$evidence_path"
}

query_vm_ownership() {
    local operation=$1
    local config_endpoint="$BASE_URL/nodes/$PVE_NODE/qemu/$VMID/config"
    local response_file="$TMP_DIR/destroy-config-response.json"
    local expected_name="bingux-install-$VMID"
    local terminal_status

    if ! api_request_with_timeout "$CONTROL_REQUEST_TIMEOUT_SECONDS" "${operation}.ownership" GET "$config_endpoint" "$response_file"; then
        if [[ ${LAST_HTTP_CODE:-000} == 404 ]]; then
            terminal_status="VM_NOT_FOUND"
        else
            terminal_status="OWNERSHIP_FAILED"
        fi
        write_request_evidence "${operation}.ownership" "$config_endpoint" "$terminal_status" "${operation}-ownership-failed" || true
        [[ $terminal_status == VM_NOT_FOUND ]] && return 2
        return 1
    fi
    if ! jq -e \
        --arg expected_name "$expected_name" \
        --arg expected_tag "$BINGUX_VM_TAG" \
        '
            .data
            | (type == "object")
            and (.name == $expected_name)
            and (
                if (.tags | type) == "string" then
                    (.tags | split(";") | index($expected_tag) != null)
                else
                    false
                end
            )
        ' "$response_file" >/dev/null 2>&1; then
        write_request_evidence "${operation}.ownership" "$config_endpoint" "OWNERSHIP_MISMATCH" "${operation}-ownership-mismatch" || true
        return 1
    fi
    if ! write_request_evidence "${operation}.ownership" "$config_endpoint" "OWNED_VM" "${operation}-ownership"; then
        error "unable to write VM ownership evidence"
        return 1
    fi
}

query_vm_power_state() {
    local operation=$1
    local status_endpoint="$BASE_URL/nodes/$PVE_NODE/qemu/$VMID/status/current"
    local response_file="$TMP_DIR/destroy-status-response.json"
    local status
    local terminal_status

    if ! api_request_with_timeout "$CONTROL_REQUEST_TIMEOUT_SECONDS" "${operation}.status" GET "$status_endpoint" "$response_file"; then
        write_request_evidence "${operation}.status" "$status_endpoint" "STATUS_FAILED" "${operation}-status-failed" || true
        return 1
    fi
    if ! status=$(jq -er '.data.status | strings | select(. == "running" or . == "stopped")' "$response_file" 2>/dev/null); then
        write_request_evidence "${operation}.status" "$status_endpoint" "INVALID_STATUS" "${operation}-status-invalid" || true
        return 1
    fi
    case $status in
        running)
            terminal_status="VM_RUNNING"
            ;;
        stopped)
            terminal_status="VM_STOPPED"
            ;;
    esac
    if ! write_request_evidence "${operation}.status" "$status_endpoint" "$terminal_status" "${operation}-status"; then
        error "unable to write VM status evidence"
        return 1
    fi
    REPLY=$status
}

destroy_vm() {
    local operation=$1
    local shutdown_endpoint
    local stop_endpoint
    local delete_endpoint
    local shutdown_response="$TMP_DIR/destroy-shutdown-response.json"
    local stop_response="$TMP_DIR/destroy-stop-response.json"
    local response_file="$TMP_DIR/destroy-response.json"
    local state
    local upid
    local evidence_path
    local ownership_status

    if ! validate_vmid "$VMID"; then
        error 'VMID failed validation before destruction'
        return 1
    fi
    shutdown_endpoint="$BASE_URL/nodes/$PVE_NODE/qemu/$VMID/status/shutdown"
    stop_endpoint="$BASE_URL/nodes/$PVE_NODE/qemu/$VMID/status/stop"
    delete_endpoint="$BASE_URL/nodes/$PVE_NODE/qemu/$VMID?purge=1&destroy-unreferenced-disks=1"
    if query_vm_ownership "$operation"; then
        :
    else
        ownership_status=$?
        if (( ownership_status == 2 )); then
            error 'VM does not exist; refusing deletion'
        else
            error 'VM is not an owned Bingux disposable VM; refusing deletion'
        fi
        return 1
    fi
    if ! query_vm_power_state "$operation"; then
        error 'unable to determine VM state before destruction'
        return 1
    fi
    state=$REPLY
    if [[ $state == running ]] && ! request_and_wait_task "${operation}.shutdown" POST "$shutdown_endpoint" "$shutdown_response"; then
        error 'graceful VM shutdown failed; attempting explicit stop'
        if ! request_and_wait_task "${operation}.stop" POST "$stop_endpoint" "$stop_response"; then
            error 'explicit VM stop failed; refusing deletion'
            return 1
        fi
    fi
    if ! api_request_with_timeout "$CONTROL_REQUEST_TIMEOUT_SECONDS" "$operation" DELETE "$delete_endpoint" "$response_file"; then
        write_request_evidence "$operation" "$delete_endpoint" "DELETE_FAILED" "$operation-failed" || true
        return 1
    fi
    if ! upid=$(jq -er '.data | strings' "$response_file" 2>/dev/null) || ! validate_upid "$upid"; then
        write_request_evidence "$operation" "$delete_endpoint" "INVALID_TASK" "$operation-invalid-task" || true
        return 1
    fi
    next_evidence_path "$operation"
    evidence_path=$REPLY
    if ! wait_for_task "$operation" "$delete_endpoint" "$upid" "$evidence_path"; then
        return 1
    fi
    return 0
}
start_vm() {
    local start_endpoint="$BASE_URL/nodes/$PVE_NODE/qemu/$VMID/status/start"
    local response_file="$TMP_DIR/start-response.json"
    local upid
    local evidence_path

    LAST_EVIDENCE_WRITTEN=0
    LAST_TASK_TERMINAL=0
    START_TASK_TERMINAL=0
    START_REQUEST_ATTEMPTED=1
    if ! api_request_with_timeout "$CONTROL_REQUEST_TIMEOUT_SECONDS" start POST "$start_endpoint" "$response_file"; then
        if ! write_request_evidence start "$start_endpoint" "START_FAILED" start-failed; then
            LAST_EVIDENCE_WRITTEN=0
        else
            LAST_EVIDENCE_WRITTEN=1
        fi
        return 1
    fi
    if ! upid=$(jq -er '.data | strings' "$response_file" 2>/dev/null) || ! validate_upid "$upid"; then
        if ! write_request_evidence start "$start_endpoint" "INVALID_TASK" start-invalid-task; then
            LAST_EVIDENCE_WRITTEN=0
        else
            LAST_EVIDENCE_WRITTEN=1
        fi
        return 1
    fi
    next_evidence_path start
    evidence_path=$REPLY
    if ! wait_for_task start "$start_endpoint" "$upid" "$evidence_path"; then
        START_TASK_TERMINAL=$LAST_TASK_TERMINAL
        return 1
    fi
    START_TASK_TERMINAL=$LAST_TASK_TERMINAL
    return 0
}

create_vm() {
    local upload_endpoint="$BASE_URL/nodes/$PVE_NODE/storage/$PVE_ISO_STORAGE/upload"
    local nextid_endpoint="$BASE_URL/cluster/nextid"
    local create_endpoint="$BASE_URL/nodes/$PVE_NODE/qemu"
    local upload_response="$TMP_DIR/upload-response.json"
    local nextid_response="$TMP_DIR/nextid-response.json"
    local create_response="$TMP_DIR/create-response.json"
    local upload_upid
    local create_upid
    local evidence_path
    local scsi0
    local ide2
    local net0

    VM_CREATION_ATTEMPTED=0
    CREATE_TASK_TERMINAL=0
    START_REQUEST_ATTEMPTED=0
    START_TASK_TERMINAL=0
    if ! api_request_with_timeout "$UPLOAD_REQUEST_TIMEOUT_SECONDS" upload POST "$upload_endpoint" "$upload_response" \
        --form-string 'content=iso' \
        --form "filename=@$ISO"; then
        write_request_evidence upload "$upload_endpoint" "UPLOAD_FAILED" upload-failed || true
        return 1
    fi
    if ! upload_upid=$(jq -er '.data | strings' "$upload_response" 2>/dev/null) || ! validate_upid "$upload_upid"; then
        write_request_evidence upload "$upload_endpoint" "INVALID_TASK" upload-invalid-task || true
        return 1
    fi
    next_evidence_path 'upload'
    evidence_path=$REPLY
    if ! wait_for_task upload "$upload_endpoint" "$upload_upid" "$evidence_path"; then
        return 1
    fi

    if ! api_request_with_timeout "$CONTROL_REQUEST_TIMEOUT_SECONDS" nextid GET "$nextid_endpoint" "$nextid_response"; then
        write_request_evidence nextid "$nextid_endpoint" "NEXTID_FAILED" nextid-failed || true
        return 1
    fi
    if ! VMID=$(jq -er '.data | tostring | select(test("^[1-9][0-9]*$"))' "$nextid_response" 2>/dev/null) || ! validate_vmid "$VMID"; then
        write_request_evidence nextid "$nextid_endpoint" "INVALID_VMID" nextid-invalid-vmid || true
        return 1
    fi

    scsi0="$PVE_VM_STORAGE:64,discard=on"
    ide2="$PVE_ISO_STORAGE:iso/$ISO_NAME,media=cdrom"
    net0="virtio,bridge=$PVE_BRIDGE"
    VM_CREATION_ATTEMPTED=1
    LAST_TASK_TERMINAL=0
    if ! api_request_with_timeout "$CONTROL_REQUEST_TIMEOUT_SECONDS" create POST "$create_endpoint" "$create_response" \
        --data-urlencode "vmid=$VMID" \
        --data-urlencode "name=bingux-install-$VMID" \
        --data-urlencode "tags=$BINGUX_VM_TAG" \
        --data-urlencode "scsi0=$scsi0" \
        --data-urlencode "ide2=$ide2" \
        --data-urlencode 'boot=order=ide2;scsi0' \
        --data-urlencode "cores=$PVE_VM_CORES" \
        --data-urlencode "memory=$PVE_VM_MEMORY_MIB" \
        --data-urlencode 'cpu=host' \
        --data-urlencode 'ostype=l26' \
        --data-urlencode "net0=$net0"; then
        write_request_evidence create "$create_endpoint" "CREATE_FAILED" create-failed || true
        return 1
    fi
    if ! create_upid=$(jq -er '.data | strings' "$create_response" 2>/dev/null) || ! validate_upid "$create_upid"; then
        write_request_evidence create "$create_endpoint" "INVALID_TASK" create-invalid-task || true
        return 1
    fi
    next_evidence_path 'create'
    evidence_path=$REPLY
    if ! wait_for_task create "$create_endpoint" "$create_upid" "$evidence_path"; then
        CREATE_TASK_TERMINAL=$LAST_TASK_TERMINAL
        return 1
    fi
    CREATE_TASK_TERMINAL=$LAST_TASK_TERMINAL
    if ! start_vm; then
        return 1
    fi
    printf 'created and started vmid=%s evidence_dir=%s\n' "$VMID" "$RUN_DIR"
    return 0
}

parse_create_args() {
    ISO=
    EVIDENCE_DIR=
    DESTROY_ON_FAILURE=0
    DRY_RUN=0
    local iso_seen=0
    local evidence_seen=0

    while (($# > 0)); do
        case $1 in
            --iso)
                (( iso_seen == 0 )) || fail_usage 'duplicate --iso'
                (($# >= 2)) || fail_usage '--iso requires FILE'
                ISO=$2
                iso_seen=1
                shift 2
                ;;
            --evidence-dir)
                (( evidence_seen == 0 )) || fail_usage 'duplicate --evidence-dir'
                (($# >= 2)) || fail_usage '--evidence-dir requires DIR'
                EVIDENCE_DIR=$2
                evidence_seen=1
                shift 2
                ;;
            --destroy-on-failure)
                (( DESTROY_ON_FAILURE == 0 )) || fail_usage 'duplicate --destroy-on-failure'
                DESTROY_ON_FAILURE=1
                shift
                ;;
            --dry-run)
                (( DRY_RUN == 0 )) || fail_usage 'duplicate --dry-run'
                DRY_RUN=1
                shift
                ;;
            *)
                fail_usage "unsupported create argument: $1"
                ;;
        esac
    done

    (( iso_seen == 1 )) || fail_usage 'create requires --iso FILE'
    (( evidence_seen == 1 )) || fail_usage 'create requires --evidence-dir DIR'
    validate_single_line_value '--evidence-dir' "$EVIDENCE_DIR"
    if (( DRY_RUN == 1 )); then
        validate_dry_run_iso_argument "$ISO"
    else
        validate_iso_argument "$ISO"
    fi
}

parse_destroy_args() {
    VMID=
    EVIDENCE_DIR=
    DRY_RUN=0
    local vmid_seen=0
    local evidence_seen=0

    while (($# > 0)); do
        case $1 in
            --vmid)
                (( vmid_seen == 0 )) || fail_usage 'duplicate --vmid'
                (($# >= 2)) || fail_usage '--vmid requires ID'
                VMID=$2
                vmid_seen=1
                shift 2
                ;;
            --evidence-dir)
                (( evidence_seen == 0 )) || fail_usage 'duplicate --evidence-dir'
                (($# >= 2)) || fail_usage '--evidence-dir requires DIR'
                EVIDENCE_DIR=$2
                evidence_seen=1
                shift 2
                ;;
            --dry-run)
                (( DRY_RUN == 0 )) || fail_usage 'duplicate --dry-run'
                DRY_RUN=1
                shift
                ;;
            *)
                fail_usage "unsupported destroy argument: $1"
                ;;
        esac
    done

    (( vmid_seen == 1 )) || fail_usage 'destroy requires --vmid ID'
    (( evidence_seen == 1 )) || fail_usage 'destroy requires --evidence-dir DIR'
    validate_single_line_value '--evidence-dir' "$EVIDENCE_DIR"
    if ! validate_vmid "$VMID"; then
        error 'destroy requires a VMID from 100 through 999999999'
        exit 2
    fi
}

main() {
    local operation=${1:-}
    shift || true
    case $operation in
        create)
            parse_create_args "$@"
            ;;
        destroy)
            parse_destroy_args "$@"
            ;;
        *)
            usage
            exit 2
            ;;
    esac

    validate_environment "$operation"
    if (( DRY_RUN == 1 )); then
        if [[ $operation == create ]]; then
            print_create_dry_run
        else
            print_destroy_dry_run
        fi
        return 0
    fi

    prepare_runtime
    EVIDENCE_SEQUENCE=0
    VM_CREATION_ATTEMPTED=0
    CREATE_TASK_TERMINAL=0
    START_REQUEST_ATTEMPTED=0
    START_TASK_TERMINAL=0
    CLEANUP_ATTEMPTED=0

    if [[ $operation == create ]]; then
        if create_vm; then
            return 0
        fi
        if ! maybe_cleanup_after_failure; then
            return 1
        fi
        return 1
    fi

    if destroy_vm destroy; then
        printf 'destroyed vmid=%s evidence_dir=%s\n' "$VMID" "$RUN_DIR"
        return 0
    fi
    return 1
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
    main "$@"
fi
