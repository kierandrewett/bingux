[Desktop Entry]
Type=Application
Name=Settings
Comment=Change Bingux and system settings
Exec=bingux-settings
Icon=bingux-settings
Terminal=false
Categories=Settings;DesktopSettings;
Keywords=Preferences;Configuration;Appearance;Display;Sound;Network;Bluetooth;Power;Keyboard;Mouse;
StartupWMClass=bingux-settings
StartupNotify=true
Actions=Network;Bluetooth;Displays;Sound;Appearance;Power;

[Desktop Action Network]
Name=Network
Exec=bingux-settings network

[Desktop Action Bluetooth]
Name=Bluetooth
Exec=bingux-settings bluetooth

[Desktop Action Displays]
Name=Displays
Exec=bingux-settings display

[Desktop Action Sound]
Name=Sound
Exec=bingux-settings sound

[Desktop Action Appearance]
Name=Appearance
Exec=bingux-settings background

[Desktop Action Power]
Name=Power
Exec=bingux-settings power
