@@ -0,0 +1,48 @@
+#include <qlocalsocket.h>
+#include <qsignalspy.h>
+#include <qtemporarydir.h>
+#include <QtTest/QtTest>
+
+#include "../ipc.hpp"
+
+namespace {
+
+class TestIpcConnection: public QObject {
+	Q_OBJECT;
+
+private slots:
+	void disconnectDeletesConnection();
+};
+
+void TestIpcConnection::disconnectDeletesConnection() {
+	QTemporaryDir directory;
+	QVERIFY(directory.isValid());
+
+	qs::ipc::IpcServer server(directory.filePath("ipc.sock"));
+	QLocalSocket client;
+	client.connectToServer(directory.filePath("ipc.sock"));
+	QVERIFY(client.waitForConnected());
+
+	QTRY_VERIFY(server.findChild<qs::ipc::IpcServerConnection*>() != nullptr);
+	auto* connection = server.findChild<qs::ipc::IpcServerConnection*>();
+	QSignalSpy destroyed(connection, &QObject::destroyed);
+	QVERIFY(destroyed.isValid());
+	auto* socket = connection->findChild<QLocalSocket*>();
+	QVERIFY(socket != nullptr);
+	QSignalSpy socketDestroyed(socket, &QObject::destroyed);
+	QVERIFY(socketDestroyed.isValid());
+
+	client.disconnectFromServer();
+	if (client.state() != QLocalSocket::UnconnectedState) {
+		QVERIFY(client.waitForDisconnected());
+	}
+	QTRY_COMPARE(destroyed.count(), 1);
+	QCOMPARE(socketDestroyed.count(), 1);
+	QTRY_VERIFY(server.findChild<qs::ipc::IpcServerConnection*>() == nullptr);
+}
+
+} // namespace
+
+QTEST_MAIN(TestIpcConnection)
+
+#include "ipcconnection.moc"
