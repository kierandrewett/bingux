+	// A config folder that ships a qmldir in every directory needs none of the qs: rewriting.
+	// Loading it as ordinary files lets Qt keep its compiled-unit disk cache, which the qs:
+	// network scheme defeats. QS_NO_LOCAL_FILES=1 restores the old behaviour.
+	this->localFiles = this->scanner.fileIntercepts.isEmpty() && !qEnvironmentVariableIsSet("QS_NO_LOCAL_FILES");
+
+	if (!this->localFiles) {
+		this->engine->addUrlInterceptor(&this->urlInterceptor);
+		this->engine->addImportPath("qs:@/");
+		this->engine->setNetworkAccessManagerFactory(&this->interceptNetFactory);
+	}
 	this->engine->setIncubationController(&this->delayedIncubationController);
 
 	this->engine->addImageProvider("icon", new IconImageProvider());
