[Unit]
Description=Bingux search service
PartOf=bingux.target
# The login screen's account runs its own user manager. It has no search to serve.
ConditionUser=!greeter
ConditionUser=!greetd
After=graphical-session.target

[Service]
ExecStart=/usr/libexec/bingux/search-service
Restart=on-failure
RestartSec=3
LimitCORE=0
