[Unit]
Description=Bingux helper services
# Gnoblin's standalone session activates gnoblin-session.target and does not use
# gnome-session, so that is the target this hangs off. The shell and its surfaces
# are started by Gnoblin's Lua autostart; only the helper daemons belong here.
PartOf=graphical-session.target
After=graphical-session.target
Wants=bingux-searchd.service bingux-statusd.service

[Install]
WantedBy=gnoblin-session.target
