[Unit]
Description=Refresh the login-screen wallpaper when the Bingux configuration changes
PartOf=bingux.target
ConditionUser=!greeter
ConditionUser=!greetd
# Under bsm the login-screen cache belongs to bsm (PublishAppearance) and this
# account cannot write it, so the export would fail and restart forever. The
# bridge creates %t/bsm/ready.sock before Bingux starts in a hosted session;
# the user manager does not see BSM_SESSION_ID, so test for that socket.
ConditionPathExists=!%t/bsm/ready.sock

[Path]
PathChanged=%E/bingux/bingux.toml
Unit=bingux-greeter-export.service

[Install]
WantedBy=bingux.target
