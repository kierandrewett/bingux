[Unit]
Description=Bingux desktop portal backend
PartOf=bingux.target
After=graphical-session.target

[Service]
Type=dbus
BusName=org.freedesktop.impl.portal.desktop.bingux
ExecStart=/usr/libexec/bingux/xdg-desktop-portal-bingux
Environment=BINGUXCTL=/usr/bin/binguxctl
Restart=on-failure
RestartSec=3
LimitCORE=0
