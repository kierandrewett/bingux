[Unit]
Description=Bingux secure Wayland lock client
# This is an ordinary ext-session-lock-v1 client. This unit remains
# diagnostic/manual and is intentionally not wanted by bingux.target until
# the compositor-side gate is enabled.

[Service]
Type=exec
ExecStart=/usr/bin/bingux-lock
Restart=no
LimitCORE=0
Environment=QT_QPA_PLATFORM=wayland
Environment=QML_IMPORT_PATH=/usr/lib64/bingux/qml
