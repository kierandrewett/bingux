[Unit]
Description=Bingux secure Wayland lock client
# Gnoblin's native lock path launches this fixed command and authorizes its
# exact PID. This unit remains diagnostic/manual and is intentionally not
# wanted by bingux.target until the compositor-side gate is enabled.

[Service]
Type=exec
ExecStart=/usr/bin/bingux-lock
Restart=no
LimitCORE=0
Environment=QT_QPA_PLATFORM=wayland
Environment=QML_IMPORT_PATH=/usr/lib64/bingux/qml
