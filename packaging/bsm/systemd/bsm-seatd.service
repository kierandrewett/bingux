# seatd for bsm: hands the seat's DRM and input devices to the bsm account.
# Own unit and own socket so that bsm never depends on the distribution's
# seatd.service, whose socket group and path differ between distributions.
# `bsm.service` Requires= this unit; nothing else uses the socket.
[Unit]
Description=seatd for the Bingux Session Manager
Documentation=man:seatd(1)
# seatd binds the VT and the seat's devices; do not run it next to a login
# manager that holds them.
After=systemd-logind.service systemd-udevd.service

[Service]
Type=simple
# -g bsm: members of group bsm (the bsm account) may open the seat.
Environment=SEATD_LOGLEVEL=error
ExecStart=/usr/bin/seatd -g bsm
RuntimeDirectory=bsm-seatd
RuntimeDirectoryMode=0755
Environment=SEATD_SOCK=/run/bsm-seatd/seatd.sock
Restart=on-failure
RestartSec=1
# seatd must run as root for device ownership and VT handling, with nothing else.
NoNewPrivileges=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
