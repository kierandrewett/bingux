<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>dev.drewett.bingux.Taxonomy</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>Taxonomy</name>
  <summary>Every Bingux UI component, icon and token, running</summary>
  <developer id="dev.drewett">
    <name>Kieran Drewett</name>
  </developer>
  <description>
    <p>
      Taxonomy is a reference for people who build Bingux applications. It shows
      every component, icon and design token of the Bingux UI library as a live,
      running window, grouped as foundations, icons, controls, containers and files.
    </p>
    <p>
      It is a development tool. Ordinary desktops do not need it.
    </p>
  </description>
  <launchable type="desktop-id">bingux-taxonomy.desktop</launchable>
  <url type="homepage">https://github.com/kierandrewett/bingux</url>
  <url type="bugtracker">https://github.com/kierandrewett/bingux/issues</url>
  <url type="vcs-browser">https://github.com/kierandrewett/bingux</url>
  <url type="help">https://github.com/kierandrewett/bingux/tree/main/docs</url>
  <provides>
    <binary>bingux-taxonomy</binary>
  </provides>
  <supports>
    <control>pointing</control>
    <control>keyboard</control>
    <control>touch</control>
  </supports>
  <requires>
    <display_length compare="ge">360</display_length>
  </requires>
  <content_rating type="oars-1.1"/>
  <categories>
    <category>Development</category>
    <category>Utility</category>
  </categories>
  <releases>
    <release version="0.1.0" date="2026-10-28"/>
  </releases>
</component>
